---
interface Props {
  title: string;
  category?: string;
}
const { title, category } = Astro.props;
const short = title.length > 70 ? title.slice(0, 68).trim() + '…' : title;
---

<div class="blog-cover-fallback" role="img" aria-label={title}>
  <div class="cover-pattern" aria-hidden="true"></div>
  {category && <span class="cover-eyebrow">{category}</span>}
  <span class="cover-title">{short}</span>
  <span class="cover-mark" aria-hidden="true">МЭТЧ</span>
</div>

<style>
  .blog-cover-fallback {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(600px 400px at 30% 30%, rgba(150,105,216,0.20), transparent 60%),
      linear-gradient(135deg, #2d3038 0%, #24272e 100%);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px 28px;
    color: #fff;
  }
  .cover-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size: 22px 22px;
    pointer-events: none;
    opacity: 0.7;
  }
  .cover-eyebrow {
    font-size: 10px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    margin-bottom: 10px;
    z-index: 1;
  }
  .cover-title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    color: #fff;
    z-index: 1;
    max-width: 92%;
  }
  .cover-mark {
    position: absolute;
    top: 16px;
    right: 18px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.5);
    z-index: 1;
  }
</style>
