---
const faqs = [
  {
    q: 'Это не психология и не эзотерика?',
    a: 'Нет. В основе — методика Gallup Q12 и доказательные подходы (well-being, КПТ). Мы работаем с измеримыми показателями команды, а не с абстракциями: есть замер до, план развития и замер после.',
  },
  {
    q: 'Мы уже пробовали тренинги — не сработало. Чем вы отличаетесь?',
    a: 'Тренинг без замера и внедрения — разовое событие. У нас три шага: диагностика → развитие → внедрение практик в ежедневную работу. Результат фиксируется в цифрах до и после, поэтому видно, что именно изменилось.',
  },
  {
    q: 'Сколько времени это отнимает у сотрудников?',
    a: 'Экспресс-диагностика — около 10 минут на человека. Программы развития идут модулями и подстраиваются под рабочий график, чтобы не выдёргивать команду из процессов.',
  },
  {
    q: 'Как вы измеряете результат?',
    a: 'По методике Q12 и связанным метрикам — вовлечённость, eNPS, текучесть. Снимаем показатели до старта и после внедрения, сравниваем и показываем динамику в отчёте.',
  },
  {
    q: 'Что с конфиденциальностью ответов сотрудников?',
    a: 'Ответы собираются анонимно и показываются только в агрегированном виде. Индивидуальные ответы конкретного сотрудника руководителю не раскрываются.',
  },
  {
    q: 'Сколько это стоит?',
    a: 'Стоимость зависит от размера команды и выбранного формата (диагностика, тренинг, коучинг, сопровождение). Точную вилку называем на коротком звонке после того, как поймём задачу.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="section faq-section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Частые вопросы</span>
      <h2 class="section-h-left">Отвечаем на то, что обычно спрашивают до старта</h2>
    </div>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary class="faq-q">
            <span>{f.q}</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .faq-section { background: transparent; }

  .section-head {
    margin-bottom: 40px;
    max-width: 820px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    margin-bottom: 10px;
    display: inline-block;
  }

  .section-h-left {
    font-size: 36px;
    font-weight: 600;
    line-height: 1.15;
    margin-top: 6px;
    color: #fff;
    margin-bottom: 0;
  }

  @media (max-width: 900px) { .section-h-left { font-size: 26px; } }

  .faq-list {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    background: rgba(45,48,56,0.55);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 14px;
    padding: 0 24px;
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    color: #fff;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    min-height: 44px;
  }

  .faq-q::-webkit-details-marker { display: none; }

  .faq-icon {
    flex-shrink: 0;
    font-size: 24px;
    font-weight: 400;
    color: #d4b8ff;
    transition: transform 0.2s ease;
    line-height: 1;
  }

  .faq-item[open] .faq-icon { transform: rotate(45deg); }

  .faq-a {
    margin: 0;
    padding: 0 0 22px;
    color: rgba(255,255,255,0.78);
    font-size: 15px;
    line-height: 1.6;
    max-width: 68ch;
  }
</style>
