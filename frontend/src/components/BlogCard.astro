---
import { Image } from 'astro:assets';
import BlogCover from './BlogCover.astro';
import { formatRuDate } from '../lib/blog-slug';

interface Props {
  href: string;
  title: string;
  date: Date;
  category: string;
  excerpt?: string;
  cover?: any;
  readingMinutes?: number;
}
const { href, title, date, category, excerpt, cover, readingMinutes } = Astro.props;
---

<article class="blog-card">
  <a class="cover-wrap" href={href} aria-label={title}>
    {cover
      ? <Image src={cover} alt={title} widths={[400, 600, 800]} />
      : <BlogCover title={title} category={category} />}
  </a>
  <div class="card-body">
    <div class="card-meta">
      <span class="eyebrow">{category}</span>
      <span class="dot" aria-hidden="true">·</span>
      <span class="date">{formatRuDate(date)}</span>
      {readingMinutes && (
        <>
          <span class="dot" aria-hidden="true">·</span>
          <span class="rt">{readingMinutes} мин</span>
        </>
      )}
    </div>
    <h3><a href={href}>{title}</a></h3>
    {excerpt && <p class="excerpt">{excerpt}</p>}
    <a class="more" href={href}>Читать →</a>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    background: rgba(45,48,56,0.55);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
    height: 100%;
  }
  .blog-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,0.18);
  }
  .cover-wrap {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #1f2228;
  }
  .cover-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card-body {
    padding: 18px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 12px;
    color: rgba(255,255,255,0.6);
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
  }
  .dot { color: rgba(255,255,255,0.35); }
  h3 {
    margin: 4px 0 0;
    font-size: 18px;
    line-height: 1.3;
    font-weight: 600;
    color: #fff;
  }
  h3 a {
    color: inherit; text-decoration: none;
    min-height: 44px; display: inline-flex; align-items: center;
  }
  h3 a:hover { color: #d4b8ff; }
  .excerpt {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: rgba(255,255,255,0.75);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .more {
    margin-top: auto;
    color: #9669d8;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    padding: 12px 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .more:hover { color: #8555c4; }
</style>
