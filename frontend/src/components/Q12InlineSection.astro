---
const base = import.meta.env.BASE_URL;
---

<section class="section section-diag-bg">
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">Экспресс-оценка · Q12 по методике Gallup</span>
      <h2 class="section-h">Проверьте устойчивость своей команды<br/>за 10 минут. Прямо сейчас.</h2>
      <p class="section-lead">Отвечайте как руководитель — за свою команду. 12 коротких вопросов, результат сразу.</p>
    </div>
    <div class="q12-inline glass-container" id="q12-inline">
      <div class="q12-meta">Вопрос 1 из 12</div>
      <div class="q12-progress"><div class="q12-progress-fill" style="width: 8%"></div></div>
      <div class="q12-q">Знают ли ваши сотрудники, чего вы от них ожидаете?</div>
      <div class="q12-row">
        <button class="answer-btn" id="q12-yes" data-value="true">Да</button>
        <button class="answer-btn" id="q12-no"  data-value="false">Нет</button>
      </div>
      <div class="q12-note">Результат — сразу. Без регистрации. Без автозвонков.</div>
    </div>
  </div>
</section>

<script define:vars={{ base }}>
  const yes = document.getElementById('q12-yes');
  const no  = document.getElementById('q12-no');

  function handleAnswer(value) {
    try {
      const saved = JSON.parse(localStorage.getItem('met4-q12') || '[]');
      saved[0] = value;
      localStorage.setItem('met4-q12', JSON.stringify(saved));
    } catch (e) { /* ignore */ }
    const btn = value ? yes : no;
    btn?.classList.add('selected');
    setTimeout(() => { window.location.href = `${base}assessment/`; }, 400);
  }

  yes?.addEventListener('click', () => handleAnswer(true));
  no?.addEventListener('click',  () => handleAnswer(false));
</script>

<style>
  .section-diag-bg { background: transparent; }

  .section-head {
    margin-bottom: 40px;
    max-width: 820px;
  }

  .section-head.centered {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    margin-bottom: 10px;
    display: inline-block;
  }

  .section-h {
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
    color: #fff;
    text-align: center;
    margin-bottom: 0;
  }

  @media (min-width: 720px) { .section-h { font-size: 36px; } }

  .section-lead {
    font-size: 15px;
    line-height: 1.5;
    color: rgba(255,255,255,0.75);
    text-align: center;
    max-width: 560px;
    margin: 14px auto 0;
  }

  .q12-inline {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px;
  }

  @media (max-width: 720px) {
    .q12-inline { padding: 28px 20px; }
  }

  .q12-meta {
    font-size: 12px;
    color: rgba(255,255,255,0.6);
    text-align: center;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .q12-progress {
    height: 6px;
    background: rgba(255,255,255,0.08);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 28px;
  }

  .q12-progress-fill {
    height: 100%;
    background: var(--color-accent);
  }

  .q12-q {
    font-size: 22px;
    line-height: 1.45;
    color: #fff;
    text-align: center;
    margin-bottom: 28px;
    font-weight: 500;
  }

  @media (max-width: 720px) { .q12-q { font-size: 18px; } }

  .q12-row {
    display: flex;
    gap: 14px;
    justify-content: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .answer-btn {
    min-width: 140px;
    padding: 16px 32px;
    border: 2px solid rgba(255,255,255,0.12);
    border-radius: 12px;
    background: rgba(45,48,56,0.65);
    color: #fff;
    font-size: 16px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 52px;
  }

  .answer-btn:hover {
    border-color: var(--color-accent);
    background: rgba(150,105,216,0.20);
  }

  .answer-btn.selected {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .q12-note {
    text-align: center;
    font-size: 12px;
    color: rgba(255,255,255,0.6);
    margin-top: 8px;
  }
</style>
