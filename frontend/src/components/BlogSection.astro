---
import { getCollection } from 'astro:content';
import { formatRuDate } from '../lib/blog-slug';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.hideFromHome)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<section class="section section-surface">
  <div class="container">
    <div class="section-head row-head">
      <div>
        <span class="eyebrow">Экспертиза</span>
        <h2 class="section-h-left">Разборы и исследования</h2>
      </div>
      <a class="head-link" href={`${base}blog/`}>Все материалы →</a>
    </div>
    <div class="blog-grid">
      {posts.map((p) => (
        <article class="blog-teaser card-solid">
          <div class="blog-meta">
            <span class="eyebrow small">{p.data.category}</span>
            <span class="blog-date">{formatRuDate(p.data.date)}</span>
          </div>
          <h3>
            <a href={`${base}blog/${p.id}/`}>{p.data.title}</a>
          </h3>
          {p.data.excerpt && <p class="teaser-text">{p.data.excerpt}</p>}
          <a href={`${base}blog/${p.id}/`} class="blog-link">Читать →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-surface {
    background: rgba(45,48,56,0.45);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    border-top: 1px solid rgba(255,255,255,0.12);
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }
  .section-head { margin-bottom: 40px; max-width: 820px; }
  .section-head.row-head {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 24px; max-width: none; flex-wrap: wrap;
  }
  .eyebrow {
    font-size: 11px; letter-spacing: 0.10em; text-transform: uppercase;
    color: #d4b8ff; font-weight: 700; margin-bottom: 10px; display: inline-block;
  }
  .eyebrow.small { font-size: 10px; margin-bottom: 0; }
  .section-h-left {
    font-size: 36px; font-weight: 600; line-height: 1.15;
    margin-top: 6px; color: #fff; margin-bottom: 0;
  }
  @media (max-width: 900px) { .section-h-left { font-size: 26px; } }
  .head-link {
    color: #9669d8; font-weight: 500; font-size: 15px;
    white-space: nowrap; text-decoration: none;
  }
  .head-link:hover { color: #8555c4; }

  .blog-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 720px)  { .blog-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
  @media (min-width: 1024px) { .blog-grid { grid-template-columns: repeat(3, 1fr); gap: 28px; } }

  .blog-teaser {
    padding: 26px 28px 28px;
    background: rgba(45,48,56,0.65);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 16px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .blog-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .blog-date { font-size: 12px; color: rgba(255,255,255,0.55); }
  .blog-teaser h3 {
    font-size: 18px; font-weight: 600; line-height: 1.3;
    color: #fff; margin: 0;
  }
  .blog-teaser h3 a { color: inherit; text-decoration: none; }
  .blog-teaser h3 a:hover { color: #d4b8ff; }
  .teaser-text {
    font-size: 14px; line-height: 1.55;
    color: rgba(255,255,255,0.72);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-link {
    margin-top: auto; color: #9669d8;
    font-size: 14px; font-weight: 600; text-decoration: none;
  }
  .blog-link:hover { color: #8555c4; }
</style>
