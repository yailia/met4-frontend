---
const posts = [
  { date: '10 апреля', h: 'Когда обучение бесполезно: три сигнала',                         tag: 'Аналитика' },
  { date: '28 марта',  h: 'Q12 и бюджет: как объяснить CEO ценность вовлечённости',          tag: 'Практика' },
  { date: '14 марта',  h: 'Gen Z в команде: что ломается и что работает',                    tag: 'Исследование' },
];
---

<section class="section section-surface">
  <div class="container">
    <div class="section-head row-head">
      <div>
        <span class="eyebrow">Экспертиза</span>
        <h2 class="section-h-left">Разборы и исследования</h2>
      </div>
      <a class="head-link" href="/blog">Все материалы →</a>
    </div>
    <div class="blog-grid">
      {posts.map((p) => (
        <article class="blog-teaser card-solid">
          <div class="blog-meta">
            <span class="eyebrow small">{p.tag}</span>
            <span class="blog-date">{p.date}</span>
          </div>
          <h3>{p.h}</h3>
          <a href="/blog" class="blog-link">Читать →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-surface {
    background: rgba(45,48,56,0.45);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    border-top: 1px solid rgba(255,255,255,0.12);
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }

  .section-head {
    margin-bottom: 40px;
    max-width: 820px;
  }

  .section-head.row-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    max-width: none;
    flex-wrap: wrap;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    margin-bottom: 10px;
    display: inline-block;
  }

  .eyebrow.small { font-size: 10px; margin-bottom: 0; }

  .section-h-left {
    font-size: 36px;
    font-weight: 600;
    line-height: 1.15;
    margin-top: 6px;
    color: #fff;
    margin-bottom: 0;
  }

  @media (max-width: 900px) { .section-h-left { font-size: 26px; } }

  .head-link {
    color: var(--color-accent);
    font-weight: 500;
    font-size: 15px;
    white-space: nowrap;
    text-decoration: none;
  }

  .head-link:hover { color: var(--color-accent-hover); }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 720px) {
    .blog-grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }

  .blog-teaser {
    display: flex;
    flex-direction: column;
    padding: 28px;
  }

  .blog-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
    gap: 8px;
  }

  .blog-date { font-size: 12px; color: rgba(255,255,255,0.6); }

  .blog-teaser h3 { margin-bottom: 8px; color: #fff; flex: 1; }

  .blog-link {
    display: inline-block;
    margin-top: 14px;
    font-weight: 500;
    font-size: 14px;
    color: var(--color-accent);
    text-decoration: none;
  }

  .blog-link:hover { color: var(--color-accent-hover); }
</style>
