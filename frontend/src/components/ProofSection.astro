---
import { Image } from "astro:assets";
import centrRazvitiya from "../assets/clients/centr-razvitiya.png";
import cpoGrupp from "../assets/clients/cpo-grupp.png";
import mmoma from "../assets/clients/mmoma.png";
import tBuro from "../assets/clients/t-buro.png";
import testo from "../assets/clients/testo.png";
import zadachi from "../assets/clients/zadachi.png";

const clients = [
  { src: centrRazvitiya, alt: "Центр развития" },
  { src: cpoGrupp, alt: "ЦПО Групп" },
  { src: mmoma, alt: "ММОМА" },
  { src: tBuro, alt: "Т-Бюро" },
  { src: testo, alt: "Testo" },
  { src: zadachi, alt: "Задачи" },
];
---

<section class="section section-grid-bg">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Нам доверяют</span>
      <h2 class="section-h-left">Работаем с командами от 50 до 5 000 человек</h2>
    </div>
    <div class="logos-row">
      {clients.map((c) => (
        <div class="logo-cell">
          <Image src={c.src} alt={c.alt} loading="lazy" />
        </div>
      ))}
    </div>
    <div class="testimonial glass-container">
      <div class="tm-quote">«</div>
      <blockquote>
        Ваш мастер-класс на тему «Новые подходы в HR при работе с молодым
        поколением» вызвал большой интерес и живой отклик среди участников.
        Профессионализм и умение увлекательно раскрывать актуальные вопросы
        сделали выступление значимым событием программы. Участники отметили
        практическую ценность представленных идей и получили важные инсайты для
        построения эффективных HR-практик.
      </blockquote>
      <div class="tm-author">
        <div class="tm-avatar">ЭР</div>
        <div>
          <div class="tm-name">Э. М. Ребко</div>
          <div class="tm-role">Директор Корпоративного университета Санкт-Петербурга</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-grid-bg { background: transparent; }

  .section-head {
    margin-bottom: 40px;
    max-width: 820px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    margin-bottom: 10px;
    display: inline-block;
  }

  .section-h-left {
    font-size: 36px;
    font-weight: 600;
    line-height: 1.15;
    margin-top: 6px;
    color: #fff;
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .section-h-left { font-size: 26px; }
  }

  .logos-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin-bottom: 48px;
  }

  @media (min-width: 640px) { .logos-row { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 960px) { .logos-row { grid-template-columns: repeat(6, 1fr); } }

  .logo-cell {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
  }

  .logo-cell :global(img) {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0.78;
    transition: opacity 0.2s ease;
  }

  .logo-cell:hover :global(img) {
    opacity: 1;
  }

  .testimonial {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    padding: 48px 40px 36px;
    text-align: center;
  }

  @media (max-width: 720px) {
    .testimonial { padding: 40px 24px 28px; }
  }

  .tm-quote {
    position: absolute;
    top: 8px;
    left: 36px;
    font-size: 96px;
    line-height: 1;
    color: var(--color-accent);
    opacity: 0.45;
    font-family: Georgia, serif;
  }

  .testimonial blockquote {
    font-size: 19px;
    line-height: 1.55;
    color: #fff;
    margin-bottom: 24px;
    font-style: normal;
  }

  @media (max-width: 720px) {
    .testimonial blockquote { font-size: 16px; }
  }

  .tm-author {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    text-align: left;
  }

  .tm-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(150,105,216,0.6), rgba(63,143,107,0.4));
    border: 1px solid rgba(255,255,255,0.12);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .tm-name { font-size: 14px; font-weight: 600; color: #fff; }
  .tm-role { font-size: 12px; color: rgba(255,255,255,0.6); }
</style>
