---
const steps = [
  { n: 1, h: 'Диагностика', p: 'Измеряем состояние команды, выявляем зоны риска и возможностей.', dur: '2 недели' },
  { n: 2, h: 'Развитие',    p: 'Развиваем навыки, которые помогают команде держать нагрузку и восстанавливаться без потери результата.', dur: '2–3 месяца' },
  { n: 3, h: 'Внедрение',   p: 'Интегрируем практики устойчивости в ежедневную работу команды.', dur: '3 месяца +' },
];
---

<section class="section section-rings-bg">
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">Как мы работаем</span>
      <h2 class="section-h">Три шага. Измеримый результат на каждом.</h2>
    </div>
    <div class="approach-grid">
      {steps.map((s, i) => (
        <>
          <div class="approach-card card-solid">
            <div class="approach-num">{s.n}</div>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
            <div class="approach-dur">{s.dur}</div>
          </div>
          {i < steps.length - 1 && <div class="approach-arrow" aria-hidden="true">→</div>}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .section-rings-bg { background: transparent; }

  .section-head {
    margin-bottom: 40px;
    max-width: 820px;
  }

  .section-head.centered {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    margin-bottom: 10px;
    display: inline-block;
  }

  .section-h {
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
    color: #fff;
    text-align: center;
    margin-bottom: 32px;
  }

  @media (min-width: 720px) {
    .section-h { font-size: 36px; margin-bottom: 48px; }
  }

  .approach-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    align-items: stretch;
  }

  @media (min-width: 900px) {
    .approach-grid {
      grid-template-columns: 1fr 24px 1fr 24px 1fr;
    }
  }

  .approach-card {
    display: flex;
    flex-direction: column;
    text-align: center;
    height: 100%;
  }

  .approach-card p { flex: 1; color: rgba(255,255,255,0.85); }

  .approach-num {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(150,105,216,0.20);
    color: #d4b8ff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 700;
    margin: 0 auto 14px;
    border: 1px solid rgba(150,105,216,0.35);
  }

  @media (min-width: 720px) {
    .approach-num { width: 56px; height: 56px; font-size: 22px; margin-bottom: 20px; }
  }

  .approach-card h3 { margin-bottom: 10px; color: #fff; }

  .approach-dur {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid rgba(255,255,255,0.12);
    font-size: 13px;
    color: #d4b8ff;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .approach-arrow {
    display: none;
    font-size: 28px;
    color: var(--color-accent);
    align-self: center;
    justify-content: center;
    align-items: center;
    opacity: 0.6;
  }

  @media (min-width: 900px) {
    .approach-arrow { display: flex; }
  }
</style>
