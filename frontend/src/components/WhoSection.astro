---
import { Image } from "astro:assets";
import elenaPhoto from "../assets/experts/elena-ivanova.png";
import ekaterinaPhoto from "../assets/experts/ekaterina-chepurnykh.png";

const experts = [
  {
    photo: ekaterinaPhoto,
    chip: "Сооснователь",
    name: "Екатерина Чепурных",
    role: "Экс-HRD · эксперт по корпоративному well-being",
    credentials:
      "10+ лет на позиции HRD в производственных и сервисных компаниях. Психолог, групповой терапевт, ведущая программы «6 граней устойчивости».",
    tags: ["HRD-практика", "6 граней устойчивости", "Групповая терапия"],
  },
  {
    photo: elenaPhoto,
    chip: "Сооснователь",
    name: "Елена Иванова",
    role: "КПТ-психолог · карьерный консультант",
    credentials:
      "Когнитивно-поведенческий терапевт, групповой ведущий. Специализируется на тревоге, выгорании и удержании ключевых сотрудников в B2B-командах.",
    tags: ["КПТ", "Выгорание и тревога", "Удержание ключевых"],
  },
];

const base = import.meta.env.BASE_URL;
---

<section class="who-section">
  <div class="container">
    <header class="who-head">
      <span class="eyebrow">Кто ведёт</span>
      <h2 class="who-h">Команда практиков, а не теоретиков</h2>
      <p class="who-lead">
        Мы — сооснователи МЭТЧ. Соединили 10+ лет опыта в HR-управлении и
        клинической психологии, чтобы делать устойчивость команд измеримой
        бизнес-метрикой, а не «мягким навыком».
      </p>
    </header>

    <div class="who-grid">
      {experts.map((p) => (
        <article class="expert-card">
          <div class="expert-photo">
            <Image src={p.photo} alt={p.name} loading="lazy" widths={[200, 300, 440]} />
          </div>
          <div class="expert-body">
            <span class="expert-chip">
              <span class="expert-chip-dot" aria-hidden="true"></span>
              {p.chip}
            </span>
            <div class="expert-name">{p.name}</div>
            <div class="expert-role">{p.role}</div>
            <div class="expert-credentials">{p.credentials}</div>
            <div class="expert-tags">
              {p.tags.map((t) => <span class="expert-tag">{t}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="who-foot">
      <a class="who-foot-link" href={`${base}team/`}>
        Подробнее о команде и сертификатах
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .who-section {
    padding: 56px 0;
    position: relative;
  }
  @media (min-width: 720px) {
    .who-section { padding: 72px 0; }
  }
  @media (min-width: 1024px) {
    .who-section { padding: 96px 0; }
  }

  .who-head {
    margin-bottom: 36px;
    max-width: 820px;
  }
  @media (min-width: 720px) {
    .who-head { margin-bottom: 56px; }
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    display: inline-block;
  }

  .who-h {
    font-size: 28px;
    font-weight: 600;
    line-height: 1.15;
    margin-top: 6px;
    color: #fff;
    letter-spacing: -0.005em;
  }
  @media (min-width: 720px) { .who-h { font-size: 36px; } }
  @media (min-width: 1024px) { .who-h { font-size: 44px; } }

  .who-lead {
    margin-top: 18px;
    color: rgba(255,255,255,0.85);
    font-size: 15px;
    line-height: 1.65;
    max-width: 700px;
  }
  @media (min-width: 720px) {
    .who-lead { font-size: 17px; margin-top: 20px; }
  }

  .who-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  @media (min-width: 720px) {
    .who-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .who-grid { gap: 32px; }
  }

  .expert-card {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 0;
    background: rgba(45,48,56,0.65);
    backdrop-filter: blur(12px) saturate(150%);
    -webkit-backdrop-filter: blur(12px) saturate(150%);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.20);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  @media (min-width: 720px) {
    .expert-card { grid-template-columns: 180px 1fr; }
  }
  @media (min-width: 1024px) {
    .expert-card { grid-template-columns: 220px 1fr; }
  }
  .expert-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    border-color: rgba(255,255,255,0.18);
  }

  .expert-photo {
    position: relative;
    width: 100%;
    height: 100%;
    background: #1f2228;
    overflow: hidden;
  }

  .expert-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    display: block;
  }

  .expert-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: rgba(150,105,216,0.15);
    border: 1px solid rgba(150,105,216,0.30);
    border-radius: 999px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #d4b8ff;
    margin-bottom: 10px;
    width: fit-content;
  }
  .expert-chip-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #9669d8;
    box-shadow: 0 0 0 2px rgba(150,105,216,0.25);
  }

  .expert-body {
    padding: 20px 20px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  @media (min-width: 720px)  { .expert-body { padding: 24px 26px 26px; } }
  @media (min-width: 1024px) { .expert-body { padding: 28px 32px 30px; } }

  .expert-name {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    color: #fff;
    margin-bottom: 6px;
  }
  @media (min-width: 720px)  { .expert-name { font-size: 22px; } }
  @media (min-width: 1024px) { .expert-name { font-size: 24px; } }

  .expert-role {
    font-size: 13px;
    font-weight: 500;
    color: #9669d8;
    letter-spacing: 0.01em;
    margin-bottom: 18px;
  }
  @media (min-width: 720px) { .expert-role { font-size: 14px; margin-bottom: 22px; } }

  .expert-credentials {
    border-top: 1px solid rgba(255,255,255,0.12);
    padding-top: 16px;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255,255,255,0.85);
    flex: 1;
  }
  @media (min-width: 720px) { .expert-credentials { font-size: 15px; line-height: 1.65; padding-top: 18px; } }

  .expert-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }
  .expert-tag {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgba(255,255,255,0.85);
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    padding: 5px 10px;
  }

  .who-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  @media (min-width: 720px) { .who-foot { margin-top: 40px; } }

  .who-foot-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #9669d8;
    font-weight: 600;
    font-size: 15px;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .who-foot-link:hover {
    color: #8555c4;
    border-bottom-color: #8555c4;
  }
  .who-foot-link .arrow {
    transition: transform 0.15s ease;
  }
  .who-foot-link:hover .arrow { transform: translateX(2px); }

  .who-foot-note {
    color: rgba(255,255,255,0.60);
    font-size: 13px;
    letter-spacing: 0.01em;
  }
</style>
