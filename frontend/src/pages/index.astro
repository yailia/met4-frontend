---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WhoSection from '../components/WhoSection.astro';
import ProblemsSection from '../components/ProblemsSection.astro';
import ProofSection from '../components/ProofSection.astro';
import ApproachSection from '../components/ApproachSection.astro';
import Q12InlineSection from '../components/Q12InlineSection.astro';
import FormatsSection from '../components/FormatsSection.astro';
import BlogSection from '../components/BlogSection.astro';
import FaqSection from '../components/FaqSection.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://met4.ru';
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "МЭТЧ",
  "url": siteUrl,
  "logo": `${siteUrl}/og-image.png`,
  "description": "Повышаем эффективность компании через устойчивость команд",
  "sameAs": ["https://t.me/met4_ru"]
};
---

<BaseLayout title="МЭТЧ — Повышаем эффективность компании через устойчивость команд" description="Бесплатная Q12-диагностика команды за 10 минут. Измерим вовлечённость, выявим зоны риска, дадим рекомендации.">
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <main>
    <Hero />
    <WhoSection />
    <ProblemsSection />
    <ProofSection />
    <ApproachSection />
    <Q12InlineSection />
    <FormatsSection />
    <BlogSection />
    <FaqSection />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
