---
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = [
  {
    date: '10 апреля 2026',
    h: 'Когда обучение бесполезно: три диагностических сигнала',
    tag: 'Аналитика',
    insight: 'Если сотрудники не восстанавливаются между пиками, тренинг только усилит выгорание.',
  },
  {
    date: '28 марта 2026',
    h: 'Q12 и бюджет: как объяснить CEO ценность вовлечённости',
    tag: 'Практика',
    insight: '4 метрики, которые переводят «мягкие» показатели в язык финансового отчёта.',
  },
  {
    date: '14 марта 2026',
    h: 'Gen Z в команде: что ломается и что на самом деле работает',
    tag: 'Исследование',
    insight: 'Разбор трёх типичных конфликтов и четырёх рабочих управленческих решений.',
  },
];
---

<BaseLayout title="Экспертиза — МЭТЧ" description="Аналитика, кейсы и разборы исследований по устойчивости, выгоранию и вовлечённости.">
  <main>
    <div class="container blog-wrap">
      <div class="page-header">
        <span class="eyebrow">Экспертиза</span>
        <h1>Разборы и исследования</h1>
        <p class="section-lead">
          Аналитика, кейсы и разборы исследований по устойчивости, выгоранию и вовлечённости.
        </p>
      </div>

      <div class="blog-grid">
        {posts.map((p) => (
          <article class="blog-card card-solid">
            <div class="blog-meta">
              <span class="eyebrow">{p.tag}</span>
              <span class="blog-date">{p.date}</span>
            </div>
            <h3>{p.h}</h3>
            <p>{p.insight}</p>
            <a href="#" class="blog-link">Читать →</a>
          </article>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .blog-wrap {
    padding: 48px 0 80px;
  }

  @media (min-width: 720px) { .blog-wrap { padding: 64px 0 96px; } }

  .page-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 48px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    margin-bottom: 10px;
    display: inline-block;
  }

  .page-header h1 {
    margin-bottom: 14px;
    color: #fff;
  }

  .section-lead {
    color: rgba(255,255,255,0.85);
    font-size: 15px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (min-width: 720px) { .section-lead { font-size: 18px; } }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 720px) {
    .blog-grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    padding: 28px;
  }

  .blog-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
    gap: 8px;
  }

  .blog-meta .eyebrow { margin-bottom: 0; }

  .blog-date {
    font-size: 12px;
    color: rgba(255,255,255,0.6);
    white-space: nowrap;
  }

  .blog-card h3 {
    color: #fff;
    margin-bottom: 10px;
  }

  @media (min-width: 720px) {
    .blog-card h3 { min-height: 54px; }
  }

  .blog-card p {
    flex: 1;
    color: rgba(255,255,255,0.85);
    font-size: 14px;
    line-height: 1.55;
    margin-bottom: 0;
  }

  .blog-link {
    display: inline-block;
    margin-top: 14px;
    font-weight: 500;
    font-size: 14px;
    color: var(--color-accent);
    text-decoration: none;
  }

  .blog-link:hover { color: var(--color-accent-hover); }
</style>
