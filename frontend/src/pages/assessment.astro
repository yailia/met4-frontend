---
import BaseLayout from '../layouts/BaseLayout.astro';
import AssessmentTest from '../components/AssessmentTest.svelte';
---

<BaseLayout title="Оценка устойчивости команды — МЭТЧ" description="Пройдите диагностику устойчивости вашей команды. 10 минут, бесплатно.">
  <main>
    <div class="container assessment-wrap">
      <div class="assess-header">
        <span class="eyebrow">Q12 · методика Gallup</span>
        <h1>Оценка устойчивости команды</h1>
        <p class="section-lead">
          Пройдите Q12-диагностику — узнайте уровень вовлечённости вашей команды за 10 минут.
        </p>
      </div>
      <AssessmentTest client:load />
    </div>
  </main>
</BaseLayout>

<style>
  .assessment-wrap {
    padding: 48px 0 80px;
    max-width: 760px;
  }

  @media (min-width: 720px) { .assessment-wrap { padding: 64px 0 96px; } }

  .assess-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    margin-bottom: 10px;
    display: inline-block;
  }

  .assess-header h1 {
    margin-bottom: 12px;
    color: #fff;
  }

  .section-lead {
    color: rgba(255,255,255,0.85);
    font-size: 15px;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (min-width: 720px) { .section-lead { font-size: 18px; } }
</style>
