---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingWidget from '../components/BookingWidget.svelte';

const audience = [
  'HR BP и HRD, которым нужны цифры для руководства',
  'Руководители команд в периоде роста или турбулентности',
  'Все, кто хочет системный подход вместо «ещё одного тренинга»',
];
---

<BaseLayout title="Вебинар: Почему устойчивость = деньги — МЭТЧ" description="Зарегистрируйтесь на вебинар о том, как устойчивость команд влияет на эффективность бизнеса.">
  <main>
    <div class="container webinar-wrap">
      <div class="webinar-hero">
        <span class="eyebrow">Онлайн-разбор</span>
        <h1>Почему устойчивость = деньги</h1>
        <p class="section-lead">
          Для HR и руководителей — с кейсами и метриками. Каждую среду в 17:00 МСК, онлайн.
        </p>
      </div>

      <div class="audience-grid">
        {audience.map((t) => (
          <div class="audience-card card-solid">
            <div class="eyebrow">Для кого</div>
            <p>{t}</p>
          </div>
        ))}
      </div>

      <div class="webinar-about">
        <h2>Что разбираем</h2>
        <ul>
          <li>Что такое устойчивость команд и почему это бизнес-KPI, а не «мягкая тема»</li>
          <li>Как устойчивость влияет на продуктивность, текучесть и результаты компании</li>
          <li>Что делать руководителю, чтобы сотрудники не теряли продуктивность в сложных ситуациях</li>
          <li>Несколько практик, которые можно применить сразу после вебинара</li>
        </ul>
      </div>

      <BookingWidget kind="webinar" client:load />
    </div>
  </main>
</BaseLayout>

<style>
  .webinar-wrap {
    padding-block: 48px 80px;
  }

  @media (min-width: 720px) { .webinar-wrap { padding-block: 64px 96px; } }

  .webinar-about {
    max-width: 640px;
    margin: 0 auto 32px;
  }

  .webinar-about h2 {
    color: #fff;
    font-size: 22px;
    margin: 0 0 16px;
    text-align: center;
  }

  .webinar-about ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .webinar-about li {
    position: relative;
    padding-left: 26px;
    color: rgba(255,255,255,0.85);
    font-size: 15px;
    line-height: 1.55;
  }

  .webinar-about li::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 9px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .webinar-hero {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 48px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    margin-bottom: 10px;
    display: inline-block;
  }

  .webinar-hero h1 {
    margin-bottom: 14px;
    color: #fff;
  }

  .section-lead {
    color: rgba(255,255,255,0.85);
    font-size: 15px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (min-width: 720px) { .section-lead { font-size: 18px; } }

  .audience-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 48px;
  }

  @media (min-width: 720px) {
    .audience-grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }

  .audience-card {
    padding: 24px;
  }

  .audience-card .eyebrow {
    margin-bottom: 12px;
  }

  .audience-card p {
    color: #fff;
    font-size: 15px;
    margin: 0;
    line-height: 1.55;
  }

  .form-wrap {
    max-width: 640px;
    margin: 0 auto;
  }
</style>
