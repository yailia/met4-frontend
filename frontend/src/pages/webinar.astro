---
import BaseLayout from '../layouts/BaseLayout.astro';
import WebinarForm from '../components/WebinarForm.svelte';

const audience = [
  'HR BP и HRD, которым нужны цифры для руководства',
  'Руководители команд в периоде роста или турбулентности',
  'Все, кто хочет системный подход вместо «ещё одного тренинга»',
];
---

<BaseLayout title="Вебинар: Почему устойчивость = деньги — МЭТЧ" description="Зарегистрируйтесь на вебинар о том, как устойчивость команд влияет на эффективность бизнеса.">
  <main>
    <div class="container webinar-wrap">
      <div class="webinar-hero">
        <span class="eyebrow">Онлайн-разбор</span>
        <h1>Почему устойчивость = деньги</h1>
        <p class="section-lead">
          Для HR и руководителей — с кейсами и метриками.
        </p>
      </div>

      <div class="audience-grid">
        {audience.map((t) => (
          <div class="audience-card card-solid">
            <div class="eyebrow">Для кого</div>
            <p>{t}</p>
          </div>
        ))}
      </div>

      <div class="form-wrap glass-container">
        <WebinarForm client:load />
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .webinar-wrap {
    padding: 48px 0 80px;
  }

  @media (min-width: 720px) { .webinar-wrap { padding: 64px 0 96px; } }

  .webinar-hero {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 48px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    margin-bottom: 10px;
    display: inline-block;
  }

  .webinar-hero h1 {
    margin-bottom: 14px;
    color: #fff;
  }

  .section-lead {
    color: rgba(255,255,255,0.85);
    font-size: 15px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (min-width: 720px) { .section-lead { font-size: 18px; } }

  .audience-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 48px;
  }

  @media (min-width: 720px) {
    .audience-grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }

  .audience-card {
    padding: 24px;
  }

  .audience-card .eyebrow {
    margin-bottom: 12px;
  }

  .audience-card p {
    color: #fff;
    font-size: 15px;
    margin: 0;
    line-height: 1.55;
  }

  .form-wrap {
    max-width: 640px;
    margin: 0 auto;
  }
</style>
