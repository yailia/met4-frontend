---
import BaseLayout from '../layouts/BaseLayout.astro';

const products = [
  {
    format: 'Групповой формат',
    h: 'Тренинг по устойчивости',
    p: 'Системное развитие навыков работы с нагрузкой и стрессом.',
    result: 'Команды работают стабильнее в неопределённости.',
  },
  {
    format: 'Групповой формат',
    h: 'Тренинг по продуктивности',
    p: 'Фокус, приоритеты, управление энергией.',
    result: 'Рост эффективности без выгорания.',
  },
  {
    format: 'Групповой формат',
    h: 'Работа с поколением Z',
    p: 'Адаптация подходов управления и взаимодействия.',
    result: 'Снижение конфликтов и текучки среди молодых сотрудников.',
  },
  {
    format: 'Индивидуальный формат',
    h: 'Коучинг руководителей',
    p: 'Развитие устойчивости и ресурсности лидера.',
    result: 'Руководитель не выгорает и ведёт команду в стрессе.',
  },
  {
    format: 'Индивидуальный формат',
    h: 'Индивидуальные планы развития',
    p: 'Программы под конкретные задачи компании.',
    result: 'Персонализированный путь роста для ключевых сотрудников.',
  },
];
---

<BaseLayout title="Форматы работы — МЭТЧ" description="Тренинги, коучинг и индивидуальные планы развития для повышения устойчивости команд.">
  <main>
    <div class="container products-wrap">
      <div class="page-header">
        <span class="eyebrow">Продукты</span>
        <h1>Форматы работы</h1>
        <p class="section-lead">Пять форматов под разные задачи команд и руководителей.</p>
      </div>

      <div class="products-grid">
        {products.map((p) => (
          <div class="product-card card-solid">
            <div class="product-format eyebrow">{p.format}</div>
            <h3>{p.h}</h3>
            <p>{p.p}</p>
            <div class="product-result">
              <span class="result-label">Результат</span>
              <span class="result-value">{p.result}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="page-cta">
        <a href={`${import.meta.env.BASE_URL}contact/`} class="button-primary">Обсудить задачи напрямую</a>
        <a href={`${import.meta.env.BASE_URL}assessment/`} class="button-secondary">Пройти диагностику</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .products-wrap {
    padding: 48px 0 80px;
  }

  @media (min-width: 720px) { .products-wrap { padding: 64px 0 96px; } }

  .page-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 48px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    margin-bottom: 10px;
    display: inline-block;
  }

  .page-header h1 {
    margin-bottom: 14px;
    color: #fff;
  }

  .section-lead {
    color: rgba(255,255,255,0.85);
    font-size: 15px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (min-width: 720px) { .section-lead { font-size: 18px; } }

  .products-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    max-width: 1000px;
    margin: 0 auto 48px;
  }

  @media (min-width: 720px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
  }

  .product-card {
    padding: 28px;
  }

  @media (min-width: 720px) { .product-card { padding: 32px; } }

  .product-format {
    margin-bottom: 12px;
  }

  .product-card h3 {
    color: #fff;
    margin-bottom: 10px;
    margin-top: 0;
  }

  .product-card p {
    color: rgba(255,255,255,0.85);
    font-size: 15px;
    line-height: 1.55;
    margin-bottom: 0;
  }

  .product-result {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.12);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .result-label {
    font-size: 11px;
    color: rgba(255,255,255,0.6);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .result-value {
    font-size: 14px;
    color: #fff;
    font-weight: 500;
    line-height: 1.45;
  }

  .page-cta {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
