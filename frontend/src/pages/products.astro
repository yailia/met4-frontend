---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Форматы работы — МЭТЧ" description="Тренинги, коучинг и индивидуальные планы развития для повышения устойчивости команд.">
  <main>
    <div class="container products-wrap">
      <Breadcrumbs items={[{ name: 'Главная', href: base }, { name: 'Продукты' }]} />

      <div class="page-header">
        <span class="eyebrow">Продукты</span>
        <h1>Форматы работы</h1>
        <p class="section-lead">Пять форматов под разные задачи команд и руководителей.</p>
      </div>

      <div class="products-grid">
        {products.map((p) => (
          <a class="product-card card-solid" href={`${base}products/${p.data.slug}/`}>
            <div class="product-format eyebrow">{p.data.format}</div>
            <h3>{p.data.cardTitle}</h3>
            <p>{p.data.cardText}</p>
            <div class="product-result">
              <span class="result-label">Результат</span>
              <span class="result-value">{p.data.cardResult}</span>
            </div>
            <span class="product-more">Подробнее →</span>
          </a>
        ))}
      </div>

      <div class="page-cta">
        <a href={`${import.meta.env.BASE_URL}contact/`} class="button-primary">Обсудить задачи напрямую</a>
        <a href={`${import.meta.env.BASE_URL}assessment/`} class="button-secondary">Пройти диагностику</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .products-wrap {
    padding-block: 48px 80px;
  }

  @media (min-width: 720px) { .products-wrap { padding-block: 64px 96px; } }

  .page-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 48px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    margin-bottom: 10px;
    display: inline-block;
  }

  .page-header h1 {
    margin-bottom: 14px;
    color: #fff;
  }

  .section-lead {
    color: rgba(255,255,255,0.85);
    font-size: 15px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (min-width: 720px) { .section-lead { font-size: 18px; } }

  .products-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    max-width: 1000px;
    margin: 0 auto 48px;
  }

  @media (min-width: 720px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
  }

  .product-card {
    padding: 28px;
    display: block;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .product-card:hover {
    border-color: rgba(150,105,216,0.45);
    transform: translateY(-2px);
  }

  .product-more {
    display: inline-block;
    margin-top: 18px;
    font-size: 14px;
    color: #c4a8ee;
    font-weight: 500;
  }

  .product-card:hover .product-more { color: #fff; }

  @media (min-width: 720px) { .product-card { padding: 32px; } }

  .product-format {
    margin-bottom: 12px;
  }

  .product-card h3 {
    color: #fff;
    margin-bottom: 10px;
    margin-top: 0;
  }

  .product-card p {
    color: rgba(255,255,255,0.85);
    font-size: 15px;
    line-height: 1.55;
    margin-bottom: 0;
  }

  .product-result {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.12);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .result-label {
    font-size: 11px;
    color: rgba(255,255,255,0.6);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .result-value {
    font-size: 14px;
    color: #fff;
    font-weight: 500;
    line-height: 1.45;
  }

  .page-cta {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
