---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.svelte';
---

<BaseLayout title="Контакты — МЭТЧ" description="Свяжитесь с нами для обсуждения задач вашей компании.">
  <main>
    <div class="container contact-wrap">
      <div class="page-header">
        <span class="eyebrow">Без скриптов и автоворонок</span>
        <h1>Обсудим задачи вашей компании</h1>
        <p class="section-lead">
          Оставьте контакты — свяжемся в рабочее время, ответ в течение рабочего дня.
        </p>
      </div>

      <div class="form-wrap glass-container">
        <ContactForm client:load />
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .contact-wrap {
    padding-block: 48px 80px;
  }

  @media (min-width: 720px) { .contact-wrap { padding-block: 64px 96px; } }

  .page-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 40px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #d4b8ff;
    font-weight: 700;
    margin-bottom: 10px;
    display: inline-block;
  }

  .page-header h1 {
    margin-bottom: 14px;
    color: #fff;
  }

  .section-lead {
    color: rgba(255,255,255,0.85);
    font-size: 15px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (min-width: 720px) { .section-lead { font-size: 18px; } }

  .form-wrap {
    max-width: 700px;
    margin: 0 auto;
  }
</style>
